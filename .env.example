OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6

# Educational access-code login. Use a long, unique value.
DEMO_ACCESS_CODE=replace_with_a_long_random_access_code

# Used to sign HttpOnly session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_at_least_32_random_bytes

# Set to 1 to exercise the streaming UI without making an API request.
MOCK_AI=0
